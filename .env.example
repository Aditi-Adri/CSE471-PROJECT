# Copy this file to .env and fill in your own values.
# .env is gitignored — every collaborator keeps their own local copy.

# Standard PostgreSQL connection string.
#
# Easiest free option (no signup): run `npm run db:dev` in a separate
# terminal — it starts a free local Postgres via `prisma dev` and prints
# the exact URL to use here (it defaults to the one below).
#
# Any other free Postgres works too, with zero code changes — e.g.
# Neon (neon.tech), Supabase (supabase.com), or Railway (railway.app)
# all have free tiers. Just paste their connection string here instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10"

# Optional. Only needed if you want the smart-search category mapper to
# use Groq's free tier instead of the built-in keyword engine.
# Get a free key at https://console.groq.com/keys — leave blank and
# the app falls back to the (free, always-on) keyword engine automatically.
GROQ_API_KEY=

# =====================================================================
# Auth (registration, login, Google SSO, sessions) — Common Workflows
# =====================================================================

# Required. Signs/encrypts the session JWT. Generate one with:
#   npx auth secret
# (or `openssl rand -base64 32` if that command isn't available)
NEXTAUTH_SECRET=

# Required. The app's own base URL — NextAuth uses this to build
# OAuth callback/redirect URLs. Leave as-is for local dev.
NEXTAUTH_URL=http://localhost:3000

# Required for "Continue with Google". Create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials (Application type:
# Web application; Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google). Leave blank and the
# Google button will show a provider error, but email/password
# login still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to actually deliver password-reset emails. Free account at
# https://resend.com — no domain verification needed to send from
# their sandbox address to your own verified email while testing.
# Leave blank and reset links are printed to the `npm run dev` console
# instead, so the flow still works end-to-end locally.
RESEND_API_KEY=
EMAIL_FROM="HireLocal <onboarding@resend.dev>"

# No env vars needed for the "technician is ~10 min away" SMS alert
# (Live Tracking & SOS, Jishan) — it's a mock (logs to the console
# instead of sending) by team decision, not something waiting on
# setup. See lib/twilio.ts and docs/FEATURE_SPEC.md's tech-stack table.

# =====================================================================
# Payments (Spare Parts Shop checkout) — Module 3
# =====================================================================

# Optional. Only needed to route the shop's "Confirm payment" button
# through a real payment gateway (SSLCommerz's sandbox — genuinely
# free, no card/business verification, no real money moves). Leave
# blank and checkout still works exactly as before: the order is
# marked paid immediately with no gateway involved.
#
# Free sandbox signup (2 minutes, just an email):
#   https://developer.sslcommerz.com/registration/
# Store ID + Store Password arrive by email right after. To actually
# complete a test payment on their hosted page, use:
#   Card: 4111 1111 1111 1111, any future expiry, CVV 111
# See lib/payments/sslcommerz.ts for the integration.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
