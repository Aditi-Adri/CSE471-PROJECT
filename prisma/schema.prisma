generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// =====================================================================
/// MODULE 1 -> Common Workflows (Shiva): Registration, Login (email/
/// password + Google SSO), Logout & Session Management.
///
/// Extends the User model the team agreed to share (see note above)
/// rather than duplicating it, and adds the NextAuth.js Prisma-adapter
/// tables (Account, Session, VerificationToken) plus a dedicated
/// PasswordResetToken table for the forgot-password flow.
/// =====================================================================
model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  phone                 String?                @unique
  passwordHash          String?
  role                  Role                   @default(CUSTOMER)
  /// Account-lockout rate limiting for the credentials login flow (see
  /// lib/auth/authOptions.ts). Reset on a successful login.
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  /// Customer's saved home/service address — set from the dashboard
  /// (see app/api/account/profile). Surfaced to the assigned worker
  /// only after a booking is confirmed (arrival-code match), never
  /// before — see docs/FEATURE_SPEC.md's booking-flow section.
  address               String?
  accounts              Account[]
  /// Complaints this user filed as a customer - see Complaint below.
  complaintsFiled       Complaint[]            @relation("ComplaintsFiled")
  /// Complaints this admin resolved - see Complaint below.
  complaintsResolved    Complaint[]            @relation("ComplaintsResolved")
  /// MODULE 4 (Shiva): this user's own code to share — see Coupon
  /// below. Generated lazily on first view (lib/referrals/referralCode.ts),
  /// not at signup, so every account gets one without touching every
  /// place a User row can be created (credentials register + Google
  /// SSO via the NextAuth adapter).
  referralCode          String?                @unique
  /// Who this user signed up with the referral code of, if anyone —
  /// set once, at registration, from lib/validation/authSchemas.ts'
  /// optional `referralCode` field. Self-relation, not a separate
  /// join table: a user is referred by at most one other user, ever.
  referredById          String?
  referredBy            User?                  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]                 @relation("UserReferrals")
  /// Coupons an admin created — see Coupon below.
  createdCoupons        Coupon[]               @relation("CouponCreatedBy")
  /// Private coupons issued straight to this user (e.g. a referral
  /// reward) — see Coupon.issuedToUserId below.
  issuedCoupons         Coupon[]               @relation("CouponIssuedTo")
  couponRedemptions     CouponRedemption[]
  /// Workers this customer has starred - see Favorite below.
  favorites             Favorite[]
  /// Requests this user posted when a search came up with no matching
  /// category — see JobRequest below.
  jobRequests           JobRequest[]
  /// Spare-parts orders this worker placed — see Order below. Named
  /// `orders`, not `workerOrders`: only workers buy from the shop
  /// today, but the field itself doesn't assume a role.
  orders                Order[]
  passwordResetTokens   PasswordResetToken[]
  /// Reviews this user has left as a customer — see Review below.
  reviews               Review[]
  sessions              Session[]
  tier1Reviews          Tier1Verification[]    @relation("Tier1Reviewer")
  tier2Evaluations      Tier2SkillTest[]       @relation("Tier2Evaluator")
  tier3Reviews          Tier3PoliceClearance[] @relation("Tier3Reviewer")
  worker                Worker?
  /// Workshops this user signed up to attend — see WorkshopRegistration below.
  workshopRegistrations WorkshopRegistration[]
  /// Workshops this admin created — see Workshop below.
  workshopsCreated      Workshop[]             @relation("WorkshopCreatedBy")
  /// MODULE 3 -> FEATURE 3 (Corporate Portal): named property addresses
  /// managed by a CORPORATE user — see CorporateProperty below.
  corporateProperties   CorporateProperty[]    @relation("CorporateProperties")

  @@index([role])
}

/// Links an OAuth identity (Google, ...) to a User. Standard shape
/// expected by @next-auth/prisma-adapter — see https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Required by @next-auth/prisma-adapter's type surface. Not used for
/// reads/writes while `session.strategy = "jwt"` (credentials login
/// requires JWT sessions), but keeping the table means we can switch to
/// database sessions later with zero schema changes.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by @next-auth/prisma-adapter's type surface (used for
/// email/magic-link providers, which we don't enable — kept for the
/// same forward-compatibility reason as Session).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time, short-lived token for the "forgot password" flow. We store
/// a hash of the token (never the raw value) so a database leak alone
/// can't be used to take over an account — the raw token only ever
/// exists in the emailed link and the requester's browser.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A bookable service type (Plumbing, Electrical, ...). `keywords` powers
/// the free, zero-cost fallback classifier in lib/ai/keywordEngine.ts.
model ServiceCategory {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  description String
  icon        String
  keywords    String[]
  createdAt   DateTime         @default(now())
  workers     WorkerCategory[]

  @@index([slug])
}

model Worker {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  headline               String
  bio                    String
  area                   DhakaArea
  addressDetail          String
  hourlyRateMinBdt       Int
  hourlyRateMaxBdt       Int
  verificationTier       VerificationTier        @default(UNVERIFIED)
  yearsExperience        Int                     @default(0)
  isAvailableNow         Boolean                 @default(true)
  ratingAvg              Float                   @default(0)
  ratingCount            Int                     @default(0)
  completedJobs          Int                     @default(0)
  avatarSeed             String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  /// =====================================================================
  /// MODULE 1 -> FEATURE 3 (Jishan): Live Worker Tracking & SOS Emergency
  /// Dispatch.
  ///
  /// Real GPS, on the Worker's own row — no separate location table. A
  /// worker is only a live SOS/tracking candidate while `isOnline` is
  /// true; `currentLat`/`currentLng` are the last position their browser
  /// reported via the Geolocation API (free, no key), pushed over the
  /// existing Socket.IO connection. `locationUpdatedAt` lets us treat a
  /// stale fix (no update in a while) as effectively offline without a
  /// background job. See lib/geo.ts for the Haversine range check and
  /// app/api/sos/route.ts for how this feeds the 3km SOS broadcast.
  /// =====================================================================
  isOnline               Boolean                 @default(false)
  currentLat             Float?
  currentLng             Float?
  locationUpdatedAt      DateTime?
  /// =====================================================================
  /// MODULE 2 -> FEATURE 1 (Shiva): AI TrustScore Engine + Review Fraud
  /// Detection.
  ///
  /// A cached 0-100 composite reliability score, recomputed by
  /// lib/trust/recomputeTrustScore.ts whenever an input changes (a new
  /// review, a fraud-queue decision, a completed/responded booking, a
  /// verification tier bump) — see lib/trust/trustScore.ts for the six
  /// weighted metrics behind it. Cached rather than computed per-request
  /// so search results can sort/filter on it cheaply, same reasoning as
  /// ratingAvg/ratingCount above. Null only very briefly — every path
  /// that creates a Worker computes an initial score right away.
  /// =====================================================================
  trustScore             Float?
  trustScoreUpdatedAt    DateTime?
  /// =====================================================================
  /// MODULE 3 -> Worker Subscription & Working Radius (new feature).
  ///
  /// Every worker has exactly one "how far my listing reaches" setting.
  /// `serviceRadiusKm` is what actually gets drawn as the map circle —
  /// it starts at the free Basic range (1km) and only grows while a paid
  /// plan is active. `subscriptionTier` always matches one row in
  /// lib/constants/subscriptionPlans.ts; BASIC never expires, so
  /// `subscriptionExpiresAt` stays null for it. A paid tier's expiry is
  /// checked lazily on read instead of needing a background cron job —
  /// same "keep it simple" spirit as the rest of this codebase.
  /// `subscriptionTrialUsed` just stops the one-time 30-day free trial
  /// from being claimed twice.
  /// =====================================================================
  serviceRadiusKm        Float                   @default(1)
  subscriptionTier       SubscriptionTier        @default(BASIC)
  subscriptionExpiresAt  DateTime?
  subscriptionTrialUsed  Boolean                 @default(false)
  subscriptionOrders     SubscriptionOrder[]
  reviews                Review[]
  availability           AvailabilitySlot[]
  /// Open requests this worker has been hired for, and every request
  /// they've applied to (hired or not) — see JobRequest/
  /// JobRequestApplication below.
  hiredJobRequests       JobRequest[]            @relation("HiredForJobRequest")
  jobRequestApplications JobRequestApplication[]
  partOrders             PartOrder[]
  favoritedBy            Favorite[]
  /// Complaints filed against this worker - see Complaint above.
  complaints             Complaint[]
  tier1Verification      Tier1Verification?
  tier2SkillTest         Tier2SkillTest?
  tier3PoliceClearance   Tier3PoliceClearance?
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories             WorkerCategory[]

  @@index([area])
  @@index([verificationTier])
  @@index([isAvailableNow])
  @@index([hourlyRateMinBdt, hourlyRateMaxBdt])
  @@index([isOnline])
  @@index([trustScore])
}

/// Many-to-many: a worker can list more than one active service category.
model WorkerCategory {
  id         String          @id @default(cuid())
  workerId   String
  categoryId String
  isPrimary  Boolean         @default(false)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, categoryId])
  @@index([categoryId])
}

/// Simple recurring weekly availability block, e.g. dayOfWeek=6 (Saturday)
/// 9-18 — enough to power the "live availability" search filter without
/// needing the full booking-calendar engine (that's a separate feature).
model AvailabilitySlot {
  id        String @id @default(cuid())
  workerId  String
  dayOfWeek Int
  startHour Int
  endHour   Int
  worker    Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([dayOfWeek])
}

/// Every search is logged for analytics/audit and to demonstrate, at
/// review time, how often the keyword engine vs. the optional AI path
/// resolved a query.
model SearchLog {
  id                 String      @id @default(cuid())
  queryText          String
  detectedCategoryId String?
  matchMethod        MatchMethod
  matchConfidence    Float?
  resultCount        Int
  durationMs         Int
  createdAt          DateTime    @default(now())
  /// The area filter applied, if any — nullable because most historical
  /// rows predate this column and plenty of searches don't filter by
  /// area at all. Feeds the neighborhood demand heatmap (Module 2,
  /// Feature 2): a zero-result search filtered to a specific area is a
  /// soft "nobody here matched" signal, same idea as JobRequest but
  /// automatic instead of requiring the customer to post anything. See
  /// lib/opportunities/demandScore.ts.
  area               DhakaArea?

  @@index([createdAt])
  @@index([detectedCategoryId])
  @@index([area])
}

/// Tracks customer bookings and en-route technician status
model Booking {
  id                  String        @id @default(cuid())
  customerId          String
  customerPhone       String?
  workerId            String?
  status              BookingStatus @default(PENDING)
  destinationLat      Float
  destinationLng      Float
  etaMinutes          Int?
  tenMinuteAlertSent  Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  /// The rate both sides actually settled on (proposed or countered).
  agreedRateBdt       Int?
  /// Plaintext, short-lived, single-use, rate-limited on verification —
  /// not a secret exchanged out-of-band, more a "this is genuinely the
  /// accepted worker's own session confirming" checkpoint than a
  /// cryptographic boundary. See docs/FEATURE_SPEC.md's booking-flow
  /// notes for the full reasoning.
  arrivalCode         String?
  arrivalVerifiedAt   DateTime?
  /// What the worker countered with, if they didn't just accept.
  counterRateBdt      Int?
  /// What the customer offered when requesting the booking.
  proposedRateBdt     Int?
  /// =====================================================================
  /// MODULE 1 -> FEATURE 4 (Sudiptha): real booking request + rate
  /// bargaining + arrival-code confirmation gate.
  ///
  /// `serviceAddress` is a snapshot of what the customer typed at
  /// booking time (not a live join to User.address — they may be
  /// booking for a different address than their saved default, and a
  /// snapshot doesn't silently change if they edit their profile
  /// later). Both stay null/hidden to the worker until
  /// `arrivalVerifiedAt` is set — see app/api/bookings/[id]/route.ts.
  /// =====================================================================
  serviceAddress      String?
  /// MODULE 2 -> FEATURE 1 (Shiva): when the worker first responded
  /// (accept/reject/counter) to this request — powers the
  /// Responsiveness trust-score metric. Distinct from `updatedAt`,
  /// which keeps moving on every later step (verify-code, complete, a
  /// counter-offer, ...) so it can't be reused for this.
  respondedAt         DateTime?
  /// When this booking's status actually became COMPLETED — the
  /// review window (72h, see lib/trust/reviewEligibility.ts) is
  /// measured from here, same reasoning as respondedAt above.
  completedAt         DateTime?
  review              Review?
  /// =====================================================================
  /// MODULE 3 -> FEATURE 3 (Corporate Portal): corporate-tagged bookings.
  ///
  /// When a CORPORATE user books a technician for one of their managed
  /// properties, `isCorporateBill` is set true and the property id is
  /// recorded so the monthly invoice can aggregate costs per-property.
  /// `requestedByRole` is a snapshot of the booker's role at the time —
  /// kept as a plain string, not a Role enum, because the booking record
  /// must survive even if roles evolve later.
  /// =====================================================================
  isCorporateBill     Boolean       @default(false)
  requestedByRole     String?
  corporatePropertyId String?

  @@index([workerId])
  @@index([customerId])
  @@index([isCorporateBill])
}

/// Emergency SOS requests within a 3km radius (Module 1 F3, Jishan).
/// `alertedWorkerIds` is the snapshot of real Worker.id's the initial
/// Haversine query found online/available within `radiusKm` at request
/// time — whoever accepts first wins; the rest just stop showing it in
/// their alert list. On accept, `acceptedWorkerId` and `bookingId` are
/// set together (a real Booking is created so the same live-tracking
/// map used for normal bookings takes over from there).
model SosRequest {
  id               String    @id @default(cuid())
  customerId       String
  customerPhone    String?
  lat              Float
  lng              Float
  radiusKm         Float     @default(3.0)
  alertedWorkerIds String[]
  status           SosStatus @default(PENDING)
  acceptedWorkerId String?
  bookingId        String?
  etaMinutes       Int?
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}

/// Tier 1 — NID vs. selfie face match. `matchDistance` is a face
/// descriptor distance from the client-side comparison (lower = more
/// similar; ~<0.5 is a confident same-person match). A confident match
/// auto-approves; anything less falls back to a coordinator's manual
/// decision — the "automatic check" is a fast path, not the only path.
model Tier1Verification {
  id            String           @id @default(cuid())
  workerId      String           @unique
  nidImage      String
  selfieImage   String
  matchDistance Float?
  autoApproved  Boolean          @default(false)
  status        TierReviewStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedBy    User?            @relation("Tier1Reviewer", fields: [reviewedById], references: [id])
  worker        Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Tier 2 — physical skills test. Inherently a human, in-person
/// evaluation (the spec is explicit it's judged "directly by platform
/// coordinators") — the system only tracks the request/scheduling and
/// records the coordinator's pass/fail decision, no automation.
model Tier2SkillTest {
  id                String           @id @default(cuid())
  workerId          String           @unique
  preferredSchedule String?
  status            TierReviewStatus @default(PENDING)
  evaluatedById     String?
  evaluatorNote     String?
  requestedAt       DateTime         @default(now())
  evaluatedAt       DateTime?
  evaluatedBy       User?            @relation("Tier2Evaluator", fields: [evaluatedById], references: [id])
  worker            Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Tier 3 — police clearance document + reference checks. Also a
/// human review process; coordinators mark each reference as
/// contacted/verified alongside the document before deciding.
model Tier3PoliceClearance {
  id                String            @id @default(cuid())
  workerId          String            @unique
  clearanceDocument String
  status            TierReviewStatus  @default(PENDING)
  reviewedById      String?
  reviewNote        String?
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedBy        User?             @relation("Tier3Reviewer", fields: [reviewedById], references: [id])
  worker            Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  references        WorkerReference[]

  @@index([status])
}

/// A previous-customer reference submitted alongside Tier 3. Contacting
/// referees is a manual coordinator task the system tracks, not
/// automates — there's no legitimate way to auto-verify a phone call.
model WorkerReference {
  id           String               @id @default(cuid())
  tier3Id      String
  name         String
  phone        String
  relationship String
  contacted    Boolean              @default(false)
  verified     Boolean              @default(false)
  note         String?
  tier3        Tier3PoliceClearance @relation(fields: [tier3Id], references: [id], onDelete: Cascade)

  @@index([tier3Id])
}

// =====================================================================
// OPEN JOB REQUESTS (Adri) — not one of the PDF's numbered features;
// closes a gap the team found while building the real search/booking
// flow (see docs/FEATURE_SPEC.md, "Core discovery & booking flow",
// steps 7-8): today a search that matches no category just silently
// shows every worker. This lets the customer post what they actually
// need instead, and lets any number of interested workers apply — the
// customer then picks exactly one, same shape as a real job posting.
// =====================================================================

model JobRequest {
  id            String           @id @default(cuid())
  customerId    String
  customer      User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description   String
  area          DhakaArea
  budgetMinBdt  Int?
  budgetMaxBdt  Int?
  status        JobRequestStatus @default(OPEN)
  hiredWorkerId String?
  hiredWorker   Worker?          @relation("HiredForJobRequest", fields: [hiredWorkerId], references: [id], onDelete: SetNull)
  hiredAt       DateTime?
  createdAt     DateTime         @default(now())

  applications JobRequestApplication[]
  partOrders   PartOrder[]

  @@index([status])
  @@index([area])
}

/// A worker expressing interest in an OPEN request. Any number of
/// workers can apply to the same one; the customer reviews applicants
/// and hires exactly one via POST .../hire, which sets
/// JobRequest.hiredWorkerId and flips status to HIRED. Application
/// rows aren't deleted when that happens — "who else applied" stays
/// visible, it's just no longer actionable once the job is HIRED.
model JobRequestApplication {
  id           String     @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  /// The wage the worker is asking for this job. Shown to the customer
  /// when picking who to hire.
  wageBdt      Int
  appliedAt    DateTime   @default(now())

  @@unique([jobRequestId, workerId])
  @@index([jobRequestId])
  @@index([workerId])
}

// =====================================================================
// MODULE 3 (Adri): worker buys spare parts for a job they're hired on.
// Own simple models, separate from Sudiptha's shop (Item/Order) - a
// PartOrder is always tied to a real JobRequest, and its cost gets
// added to that job's bill instead of the worker paying for it via a
// separate checkout.
// =====================================================================

model Part {
  id         String          @id @default(cuid())
  name       String
  price      Int
  stockQty   Int             @default(0)
  orderItems PartOrderItem[]
}

/// One "buy parts for this job" trip by the hired worker.
model PartOrder {
  id           String          @id @default(cuid())
  jobRequestId String
  jobRequest   JobRequest      @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  items        PartOrderItem[]

  @@index([jobRequestId])
}

model PartOrderItem {
  id          String    @id @default(cuid())
  partOrderId String
  partOrder   PartOrder @relation(fields: [partOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity    Int
  /// Price at the time it was bought - Part.price can change later,
  /// this keeps the bill accurate to what was actually charged.
  price       Int

  @@index([partOrderId])
}

/// MODULE 4 (Adri): a customer starring a worker to rebook later, no
/// search needed. Just a join between User and Worker - unique so the
/// same worker can't be starred twice by the same customer.
model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, workerId])
  @@index([customerId])
}

// =====================================================================
// MODULE 3 (Adri): Workshops & training programs. An admin creates a
// workshop, marks it free or paid, and any worker or customer can
// register. No real payment gateway here - same simple approach as
// Parts Billing, registering just records the fee that was agreed,
// nothing is actually charged.
// =====================================================================

model Workshop {
  id          String   @id @default(cuid())
  title       String
  description String
  scheduledAt DateTime
  isPaid      Boolean  @default(false)
  /// Only set when isPaid is true.
  feeBdt      Int?
  createdById String
  createdBy   User     @relation("WorkshopCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  registrations WorkshopRegistration[]
}

/// One user's registration for one workshop. Unique so the same
/// person can't register for the same workshop twice.
model WorkshopRegistration {
  id           String   @id @default(cuid())
  workshopId   String
  workshop     Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([workshopId, userId])
  @@index([workshopId])
}

// =====================================================================
// MODULE 2 (Adri): a customer can file a complaint against a worker,
// an admin resolves it and can optionally reply. Not one of the PDF's
// numbered features. Deliberately simple and NOT tied to a booking or
// payment - keeps this separate from Jishan's still-unbuilt Module 2
// F3 (dispute resolution + escrow settlement), which is specifically
// about a completed, paid booking. This is closer to "report this
// worker" than a financial dispute.
// =====================================================================

model Complaint {
  id           String          @id @default(cuid())
  customerId   String
  customer     User            @relation("ComplaintsFiled", fields: [customerId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  subject      String
  description  String
  status       ComplaintStatus @default(PENDING)
  /// Set only once an admin resolves this complaint - see resolvedById/resolvedAt.
  adminReply   String?
  resolvedById String?
  resolvedBy   User?           @relation("ComplaintsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([customerId])
  @@index([workerId])
  @@index([status])
}

enum ComplaintStatus {
  PENDING
  RESOLVED
}

// =====================================================================
// MODULE 2 -> FEATURE 1 (Shiva): AI TrustScore Engine + Review Fraud
// Detection.
//
// A review is the customer's one-time verdict on a specific COMPLETED
// booking — `bookingId` is @unique, one review per job, not one review
// per worker. Eligibility (booking actually COMPLETED, within 72h of
// completedAt, no existing review yet) is enforced in
// lib/trust/reviewEligibility.ts, not just assumed client-side.
//
// Every submitted review is screened for fraud immediately (Groq if
// GROQ_API_KEY is configured, otherwise the free local heuristic — see
// lib/trust/fraudDetector.ts). A `fraudFlagged` review stays publicly
// visible — a flag isn't proof, just a signal — but is excluded from
// the trust score's rating/authenticity metrics and surfaced to admins
// at app/admin/reviews, who can hide one they confirm is fake.
// =====================================================================
model Review {
  id           String            @id @default(cuid())
  bookingId    String            @unique
  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId   String
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker            @relation(fields: [workerId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String
  /// Set by an admin after confirming a fraud flag — hidden reviews
  /// stay in the database (nothing here is ever deleted) but drop out
  /// of both the public list and every trust-score metric.
  isHidden     Boolean           @default(false)
  fraudFlagged Boolean           @default(false)
  /// 0..1, higher = more likely fake. Null until the fraud check runs
  /// (always synchronous on submit — see app/api/bookings/[id]/review).
  fraudScore   Float?
  fraudReason  String?
  fraudMethod  FraudCheckMethod?
  createdAt    DateTime          @default(now())

  @@index([workerId])
  @@index([fraudFlagged])
}

enum FraudCheckMethod {
  AI
  HEURISTIC
}

// =====================================================================
// MODULE 3 (Sudiptha): Spare Parts E-Commerce Shop.
//
// A parts catalog (`/shop`) + order history for workers restocking
// supplies. `OrderItem.itemName`/`unitPrice`/`subtotal` are a snapshot
// captured at purchase time, not derived live from `Item` — a later
// price/name change on the catalog never rewrites a past order's
// total. Integer autoincrement ids and `Decimal` money fields (unlike
// the cuid()/Float convention elsewhere in this schema) and
// `Order.workerId` pointing at `User.id` rather than `Worker.id` are
// kept exactly as applied rather than reshaped — this already matches
// the live database (migration: add_spare_parts_store). See
// docs/SPARE_PARTS_FEATURE.md.
// =====================================================================
model Item {
  id         Int         @id @default(autoincrement())
  name       String
  pictureUrl String?
  useCase    String
  price      Decimal     @db.Decimal(10, 2)
  stockQty   Int         @default(0)
  workType   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([workType])
  @@index([stockQty])
}

/// One checkout by a worker. `jobId` is a free-text reference to the
/// job it was bought for — no JobRequest/Booking foreign key, not
/// enforced, same "loose reference" the original migration shipped
/// with.
model Order {
  id               Int               @id @default(autoincrement())
  workerId         String
  worker           User              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  jobId            String?
  totalAmount      Decimal           @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  items            OrderItem[]
  /// =====================================================================
  /// MODULE 3 (Shiva): SSLCommerz sandbox payment integration for the
  /// Spare Parts Shop checkout.
  ///
  /// PENDING the moment the order+items are written (see
  /// app/api/shop/orders/route.ts), flipped to PAID/FAILED/CANCELLED by
  /// whichever of the gateway's callbacks lands first (success/fail/
  /// cancel redirect or the IPN — see app/api/shop/payment/*). `tranId`
  /// is what ties this row back to the gateway session; `valId` is only
  /// set once SSLCommerz's own validation API has actually confirmed the
  /// transaction server-side — the browser redirect alone is never
  /// trusted on its own. See lib/payments/sslcommerz.ts for why this is
  /// optional/graceful-fallback, same free-APIs-only pattern as Groq.
  /// =====================================================================
  paymentStatus    PaymentStatus     @default(PENDING)
  tranId           String            @unique
  valId            String?
  cardType         String?
  paidAt           DateTime?
  /// MODULE 4 (Shiva): how much a coupon knocked off this order's item
  /// total — see Coupon below. totalAmount above is already net of
  /// this (what's actually charged); this field is only kept so the
  /// bill can still show "you saved ৳X" without re-deriving it.
  discountBdt      Int               @default(0)
  couponRedemption CouponRedemption?

  @@index([workerId])
  @@index([jobId])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    Int
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([itemId])
}

/// MODULE 4 (Shiva): referral codes + coupon system for the Spare Parts
/// Shop checkout (app/api/shop/orders — the one real payment flow in
/// the app; see lib/payments/sslcommerz.ts).
///
/// A Coupon is either admin-made (source: ADMIN, public unless someone
/// sets issuedToUserId) or system-issued as a referral reward (source:
/// REFERRAL, always private — issuedToUserId is the one person who can
/// redeem it). Both go through the same redemption path:
/// lib/coupons/couponEligibility.ts decides if a code is usable right
/// now, lib/coupons/couponMath.ts turns it into a taka amount off, and
/// a CouponRedemption row is what actually enforces "not twice" — see
/// app/api/shop/orders/route.ts for where a code gets spent for real.
model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  discountType   CouponDiscountType
  /// PERCENT: 1-100 (percent off). FIXED: a flat BDT amount off.
  /// Which one `value` means depends on discountType.
  value          Int
  /// Caps a PERCENT discount in taka so "50% off" can't blow up on a
  /// large order. Ignored for FIXED. Null = uncapped.
  maxDiscountBdt Int?
  /// Order subtotal must be at least this before the coupon applies.
  /// Null = no minimum.
  minOrderBdt    Int?
  /// Total redemptions allowed across every user. Null = unlimited.
  usageLimit     Int?
  /// Redemptions allowed per user. Almost always 1 — a referral reward
  /// is inherently single-use since it's issued to one person.
  perUserLimit   Int                @default(1)
  isActive       Boolean            @default(true)
  expiresAt      DateTime?
  source         CouponSource       @default(ADMIN)
  /// Set only for a private, single-user coupon (referral rewards
  /// always set this). Null = public, anyone signed in can apply it.
  issuedToUserId String?
  issuedToUser   User?              @relation("CouponIssuedTo", fields: [issuedToUserId], references: [id], onDelete: Cascade)
  /// The admin who created this, via /admin/coupons. Null for a
  /// referral-issued coupon — nobody typed it in by hand.
  createdById    String?
  createdBy      User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  redemptions    CouponRedemption[]

  @@index([isActive])
  @@index([issuedToUserId])
}

/// One coupon actually being spent on one order. Exists mainly so
/// "has this user already used this code" and "how many times has
/// this code been used, total" are real counts instead of trusting
/// the client — see checkCouponEligibility in
/// lib/coupons/couponEligibility.ts.
model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     Int      @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountBdt Int
  redeemedAt  DateTime @default(now())

  @@index([couponId, userId])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum CouponSource {
  ADMIN
  REFERRAL
}

// =====================================================================
// MODULE 3 -> Worker Subscription & Working Radius (new feature).
//
// One row per subscription purchase (including a free 30-day trial,
// where amountBdt is 0). Deliberately shaped just like Order above —
// same PaymentStatus enum, same tranId/valId/cardType/paidAt columns —
// so it reuses the exact same SSLCommerz flow (lib/payments/sslcommerz.ts)
// instead of a second payment integration. Once a row is confirmed PAID,
// the worker's Worker.subscriptionTier / subscriptionExpiresAt /
// serviceRadiusKm are updated to match — see
// lib/payments/confirmSubscriptionPayment.ts.
// =====================================================================
model SubscriptionOrder {
  id            String           @id @default(cuid())
  workerId      String
  worker        Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  plan          SubscriptionTier
  amountBdt     Int
  /// True for the one-time 30-day free trial (amountBdt is 0 that time).
  isTrial       Boolean          @default(false)
  durationDays  Int
  paymentStatus PaymentStatus    @default(PENDING)
  tranId        String           @unique
  valId         String?
  cardType      String?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([workerId])
  @@index([paymentStatus])
}

/// MODULE 3 -> Worker Subscription & Working Radius (new feature): the
/// plan tiers a worker can be on. Matches the cards in
/// lib/constants/subscriptionPlans.ts one-to-one — BASIC is the
/// always-free default every worker starts on.
enum SubscriptionTier {
  BASIC
  STARTER
  STANDARD
  PREMIUM
  UNLIMITED
}

// =====================================================================
// MODULE 3 -> FEATURE 3 (Corporate Portal): multi-property management.
//
// A CORPORATE user can register several office/building addresses under
// their account.  Each property can be independently selected when
// placing a maintenance booking, and the monthly invoice groups costs
// by property.  `label` is the user-facing nickname ("Banani Building"),
// `address` is the full street address snapshot used for the service
// visit, `area` controls which Dhaka zone the technician search is
// scoped to.
// =====================================================================
model CorporateProperty {
  id              String    @id @default(cuid())
  corporateUserId String
  corporateUser   User      @relation("CorporateProperties", fields: [corporateUserId], references: [id], onDelete: Cascade)
  label           String
  address         String
  area            DhakaArea
  contactName     String?
  contactPhone    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([corporateUserId])
}

enum Role {
  CUSTOMER
  WORKER
  CORPORATE
  ADMIN
}

/// MODULE 3 (Shiva): Spare Parts Shop checkout payment status — see the
/// banner comment above Order.paymentStatus.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// Three-tier trust badge from the Worker Verification feature (Module 1
/// Feature 1). Stored here because search results are ranked by it.
enum VerificationTier {
  UNVERIFIED
  TIER1_ID_VERIFIED
  TIER2_SKILL_TESTED
  TIER3_POLICE_CLEARED
}

/// Service areas the platform currently covers. Kept as an enum (rather
/// than a free-text field) so filtering/indexing stays fast and clean.
enum DhakaArea {
  GULSHAN
  BANANI
  BARIDHARA
  DHANMONDI
  UTTARA
  MIRPUR
  MOHAMMADPUR
  BASHUNDHARA
  BADDA
  RAMPURA
  MOTIJHEEL
  OLD_DHAKA
  WARI
  LALMATIA
  FARMGATE
  TEJGAON
  KHILGAON
  MALIBAGH
  JATRABARI
  MOHAKHALI
  BANASREE
  SAVAR
}

/// How a search query was mapped to a category — lets us prove, and
/// measure, that the free keyword engine is doing most of the work and
/// the paid-tier-free LLM path is only used when explicitly enabled.
enum MatchMethod {
  KEYWORD
  AI
  MANUAL_FILTER
}

enum BookingStatus {
  PENDING
  IN_TRANSIT
  /// Also reused as "arrival code verified" for the real booking flow —
  /// see Booking.arrivalVerifiedAt.
  ARRIVED
  COMPLETED
  CANCELLED
  /// Customer requested this worker at a proposed rate; worker hasn't
  /// responded yet. Module 1 F4 (Sudiptha).
  PENDING_ACCEPTANCE
  /// Worker accepted (at the proposed or countered rate) — the arrival
  /// code is live, address/phone are still withheld until it's verified.
  CONFIRMED
  /// Worker declined the request outright.
  REJECTED
}

enum SosStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/// =====================================================================
/// MODULE 1 -> FEATURE 1 (Shiva): Multi-Layer Worker Verification &
/// Digital Badge System.
///
/// One row per worker per tier (not a history log) — a tier is either
/// not started (no row), awaiting a decision (PENDING), or decided
/// (APPROVED/REJECTED, re-submittable after rejection by overwriting
/// the same row). Approving a tier bumps Worker.verificationTier,
/// which is what the existing search feature already ranks and filters
/// on (see lib/search/buildWorkerQuery.ts) — this feature never
/// duplicates that ranking logic, only feeds it.
/// =====================================================================
enum TierReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobRequestStatus {
  OPEN
  HIRED
}
