// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// MODULE 1 -> FEATURE 2 (Adri): Smart Text Search, Contextual Filtering
// & AI Category Mapping.
//
// Only the models this feature needs to function are defined below
// (User is intentionally minimal — full auth/RBAC/profile fields are
// the shared "Common Workflows" build and will be extended by the team
// in the same models rather than duplicated).
// =====================================================================

enum Role {
  CUSTOMER
  WORKER
  CORPORATE
  ADMIN
}

/// Three-tier trust badge from the Worker Verification feature (Module 1
/// Feature 1). Stored here because search results are ranked by it.
enum VerificationTier {
  UNVERIFIED
  TIER1_ID_VERIFIED
  TIER2_SKILL_TESTED
  TIER3_POLICE_CLEARED
}

/// Service areas the platform currently covers. Kept as an enum (rather
/// than a free-text field) so filtering/indexing stays fast and clean.
enum DhakaArea {
  GULSHAN
  BANANI
  BARIDHARA
  DHANMONDI
  UTTARA
  MIRPUR
  MOHAMMADPUR
  BASHUNDHARA
  BADDA
  RAMPURA
  MOTIJHEEL
  OLD_DHAKA
  WARI
  LALMATIA
  FARMGATE
  TEJGAON
  KHILGAON
  MALIBAGH
  JATRABARI
  MOHAKHALI
  BANASREE
  SAVAR
}

/// How a search query was mapped to a category — lets us prove, and
/// measure, that the free keyword engine is doing most of the work and
/// the paid-tier-free LLM path is only used when explicitly enabled.
enum MatchMethod {
  KEYWORD
  AI
  MANUAL_FILTER
}

/// =====================================================================
/// MODULE 1 -> Common Workflows (Shiva): Registration, Login (email/
/// password + Google SSO), Logout & Session Management.
///
/// Extends the User model the team agreed to share (see note above)
/// rather than duplicating it, and adds the NextAuth.js Prisma-adapter
/// tables (Account, Session, VerificationToken) plus a dedicated
/// PasswordResetToken table for the forgot-password flow.
/// =====================================================================
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  passwordHash  String?
  role          Role      @default(CUSTOMER)

  /// Account-lockout rate limiting for the credentials login flow (see
  /// lib/auth/authOptions.ts). Reset on a successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker              Worker?
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

/// Links an OAuth identity (Google, ...) to a User. Standard shape
/// expected by @next-auth/prisma-adapter — see https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Required by @next-auth/prisma-adapter's type surface. Not used for
/// reads/writes while `session.strategy = "jwt"` (credentials login
/// requires JWT sessions), but keeping the table means we can switch to
/// database sessions later with zero schema changes.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by @next-auth/prisma-adapter's type surface (used for
/// email/magic-link providers, which we don't enable — kept for the
/// same forward-compatibility reason as Session).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time, short-lived token for the "forgot password" flow. We store
/// a hash of the token (never the raw value) so a database leak alone
/// can't be used to take over an account — the raw token only ever
/// exists in the emailed link and the requester's browser.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A bookable service type (Plumbing, Electrical, ...). `keywords` powers
/// the free, zero-cost fallback classifier in lib/ai/keywordEngine.ts.
model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String
  keywords    String[]
  createdAt   DateTime @default(now())

  workers WorkerCategory[]

  @@index([slug])
}

model Worker {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String
  bio              String
  area             DhakaArea
  addressDetail    String
  hourlyRateMinBdt Int
  hourlyRateMaxBdt Int
  verificationTier VerificationTier @default(UNVERIFIED)
  yearsExperience  Int              @default(0)
  isAvailableNow   Boolean          @default(true)
  ratingAvg        Float            @default(0)
  ratingCount      Int              @default(0)
  completedJobs    Int              @default(0)
  avatarSeed       String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  categories   WorkerCategory[]
  availability AvailabilitySlot[]

  @@index([area])
  @@index([verificationTier])
  @@index([isAvailableNow])
  @@index([hourlyRateMinBdt, hourlyRateMaxBdt])
}

/// Many-to-many: a worker can list more than one active service category.
model WorkerCategory {
  id         String          @id @default(cuid())
  workerId   String
  worker     Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean         @default(false)

  @@unique([workerId, categoryId])
  @@index([categoryId])
}

/// Simple recurring weekly availability block, e.g. dayOfWeek=6 (Saturday)
/// 9-18 — enough to power the "live availability" search filter without
/// needing the full booking-calendar engine (that's a separate feature).
model AvailabilitySlot {
  id        String @id @default(cuid())
  workerId  String
  worker    Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startHour Int
  endHour   Int

  @@index([workerId])
  @@index([dayOfWeek])
}

/// Every search is logged for analytics/audit and to demonstrate, at
/// review time, how often the keyword engine vs. the optional AI path
/// resolved a query.
model SearchLog {
  id                 String      @id @default(cuid())
  queryText          String
  detectedCategoryId String?
  matchMethod        MatchMethod
  matchConfidence    Float?
  resultCount        Int
  durationMs         Int
  createdAt          DateTime    @default(now())

  @@index([createdAt])
  @@index([detectedCategoryId])
}
// =====================================================================
// LIVE TRACKING & SOS FEATURE MODELS
// =====================================================================

enum BookingStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

enum SosStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

/// Stores technician GPS coordinates for live tracking & SOS proximity queries
model WorkerLocation {
  workerId       String   @id
  name           String   @default("Service Tech")
  role           String   @default("Technician")
  rating         Float    @default(5.0)
  avatarInitials String?
  lat            Float?
  lng            Float?
  isOnline       Boolean  @default(false)
  isVerified     Boolean  @default(false)
  isAvailable    Boolean  @default(true)
  updatedAt      DateTime @updatedAt @default(now())

  // Composite index for fast geolocation filtering
  @@index([isOnline, isVerified, isAvailable])
}

/// Tracks customer bookings and en-route technician status
model Booking {
  id                 String        @id @default(cuid())
  customerId         String
  customerPhone      String?       // Add this line
  workerId           String?
  status             BookingStatus @default(PENDING)
  destinationLat     Float
  destinationLng     Float
  etaMinutes         Int?
  tenMinuteAlertSent Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([workerId])
  @@index([customerId])
}

/// Emergency SOS requests within 3km boundary
model SosRequest {
  id               String    @id @default(cuid())
  customerId       String
  customerPhone    String?
  lat              Float
  lng              Float
  radiusKm         Float     @default(3.0)
  alertedWorkerIds String[]
  status           SosStatus @default(PENDING)
  acceptedWorkerId String?
  etaMinutes       Int?
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Preserve team table to prevent data drop
model Tier1Verification {
  id        String    @id @default(cuid())
  workerId  String    @unique
  status    String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}